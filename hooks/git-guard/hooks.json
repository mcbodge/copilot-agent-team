{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "sh \"$HOME/.copilot/hooks/git-guard.sh\"",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& ([IO.Path]::Combine([Environment]::GetFolderPath('UserProfile'), '.copilot', 'hooks', 'git-guard.ps1'))\"",
        "timeout": 10
      }
    ]
  }
}
